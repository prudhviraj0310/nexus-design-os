# ==========================================
# NovaDesign Platform - Environment Variables
# ==========================================

# Server Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Configuration
# When DATABASE_URL is set, NovaDesign connects to managed PostgreSQL (Supabase, Neon, AWS RDS).
# When unset or left blank, NovaDesign uses embedded PGlite in DATA_DIR.
# DATABASE_URL=postgresql://user:password@localhost:5432/novadesign
DATA_DIR=.data/novadesign-db

# Authentication & Security
NOVA_ADMIN_PASSWORD=change_this_to_a_strong_password_in_prod
NOVA_SESSION_SECRET=super_secret_session_signing_key_at_least_32_characters_long
NOVA_API_KEY=nova_live_api_key_for_mcp_agents_and_ci_pipelines_min24chars
NOVA_PUBLIC_DOCS=false

# External Provider Integrations
# Figma Personal Access Token or OAuth token for live variables sync
FIGMA_TOKEN=
# GitHub Personal Access Token or GitHub App installation token for automated pull requests
GITHUB_TOKEN=
