{
  "name": "nexus-design-os",
  "version": "1.0.0",
  "description": "Nexus Design OS — The Enterprise Design System Operating System & AI Context Engine",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build:next": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli/index.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:continuous": "tsx src/worker/index.ts --continuous",
    "collaboration": "tsx src/collaboration/server.ts",
    "build:mobile-sdk": "npm run build --workspace=@nexus-design-os/mobile-sdk",
    "smoke:postgres": "tsx scripts/postgres-concurrency-smoke.ts"
  },
  "workspaces": ["packages/*"],
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@electric-sql/pglite": "^0.2.14",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@types/ws": "^8.18.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
